# Default bootstrap mode. Keep mock until official credentials are granted.
ORULO_MODE=mock

# Official Órulo API v2 credentials.
# Never commit real values.
ORULO_CLIENT_ID=
ORULO_CLIENT_SECRET=

# OAuth/API endpoints from the official API documentation.
ORULO_TOKEN_URL=https://www.orulo.com.br/oauth/token
ORULO_API_BASE_URL=https://www.orulo.com.br/api/v2
